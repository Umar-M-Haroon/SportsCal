# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

APP_SCHEME = "SportsCal (iOS)"

# App Store Connect API key (used for binary upload + metadata).
# The .p8 lives in ~/.appstoreconnect/private_keys/ and is NOT checked in.
def asc_api_key
  app_store_connect_api_key(
    key_id: "JQ6VYF64LN",
    issuer_id: "c676fbfe-8aff-476b-b54f-89bb56cc09d6",
    key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_JQ6VYF64LN.p8"),
    in_house: false
  )
end

platform :ios do
  desc "Generate new localized screenshots"
  lane :screenshots do
    capture_screenshots(scheme: APP_SCHEME)
    frameit()
    upload_to_app_store(skip_binary_upload: true, skip_metadata: true)
  end

  desc "Push App Store TEXT metadata only (name/subtitle/keywords/promo/What's New). No archive, no screenshots."
  lane :metadata do
    # Text-only: deliver the fastlane/metadata/*.txt files. Skips the binary and
    # the screenshot upload (which is the step that 500-loops on ASC's side), so
    # listing text can be updated independently of a build.
    upload_to_app_store(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,                  # skip the HTML metadata-preview confirmation
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload the EXISTING staged screenshots only (retry after an ASC 500 on the release lane)."
  lane :upload_screenshots do
    upload_to_app_store(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true
    )
  end

  desc "Archive the app and upload the build to App Store Connect (TestFlight)"
  lane :beta do
    build_app(
      scheme: APP_SCHEME,
      export_method: "app-store",
      destination: "generic/platform=iOS",  # scheme also supports xrOS; pin to iPhone
      output_directory: "./build",
      clean: true
    )
    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: true
    )
  end

  # Builds come from Xcode Cloud (the "Default" workflow runs on every push to
  # main; its run number is the build number), so this lane never archives. It
  # finds the newest processed build for MARKETING_VERSION, pushes the text
  # metadata, attaches the build, and submits for review.
  #
  #   fastlane submit_review                  # newest build of the pbxproj version
  #   fastlane submit_review build:145        # a specific build
  #   fastlane submit_review wait_minutes:90  # wait for Xcode Cloud to upload one
  desc "Submit the newest Xcode Cloud build of the current version for App Store review"
  lane :submit_review do |options|
    api_key = asc_api_key
    version = get_version_number(xcodeproj: "SportsCal.xcodeproj", target: "SportsCal (iOS)")

    build = options[:build]
    deadline = Time.now + (options[:wait_minutes] || 0).to_i * 60
    until build
      # With no build for the version this returns initial_build_number rather
      # than raising, so 0 is the "nothing uploaded yet" sentinel.
      latest = latest_testflight_build_number(api_key: api_key, version: version, initial_build_number: 0)
      build = latest if latest.to_i > 0
      break if build
      UI.user_error!("No build for #{version} in App Store Connect — push to main so Xcode Cloud builds one, or pass wait_minutes:") if Time.now > deadline
      UI.message("No #{version} build yet; checking again in 2 minutes…")
      sleep(120)
    end
    # An uploaded build is invisible to deliver's build lookup until Apple
    # finishes processing it (~10-30 min after Xcode Cloud's upload).
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    loop do
      candidate = app.get_builds(filter: { version: build.to_s, "preReleaseVersion.version" => version }).first
      break if candidate&.processed?
      UI.user_error!("#{version} (#{build}) failed processing: #{candidate.processing_state}") if candidate && !candidate.processing?
      UI.user_error!("#{version} (#{build}) still processing after the wait window") if Time.now > deadline + 45 * 60
      UI.message("#{version} (#{build}) is still processing; checking again in 1 minute…")
      sleep(60)
    end

    # App Review contact — required for submission. Kept out of git in the
    # gitignored fastlane/.env (fastlane loads it automatically).
    review_contact = %w[FIRST_NAME LAST_NAME EMAIL PHONE].to_h do |field|
      key = "REVIEW_CONTACT_#{field}"
      UI.user_error!("Set #{key} in fastlane/.env (phone as +<country code> …)") if ENV[key].to_s.strip.empty?
      [field.downcase, ENV[key]]
    end

    UI.important("Submitting #{version} (#{build}) for review")

    upload_to_app_store(
      api_key: api_key,
      app_version: version,         # renames the editable version if it's still an older number
      build_number: build.to_s,
      skip_binary_upload: true,
      skip_screenshots: true,       # screenshots carry over; their upload is the step that 500-loops
      skip_metadata: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      reject_if_possible: true,     # replace a submission that's still waiting for review
      app_review_information: {
        first_name: review_contact["first_name"],
        last_name: review_contact["last_name"],
        email_address: review_contact["email"],
        phone_number: review_contact["phone"]
      },
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
    UI.success("#{version} (#{build}) is in review.")
  end

  desc "Full release: archive, upload binary + What's New, ready to submit in App Store Connect"
  lane :release do
    build_app(
      scheme: APP_SCHEME,
      export_method: "app-store",
      destination: "generic/platform=iOS",  # scheme also supports xrOS; pin to iPhone
      output_directory: "./build",
      clean: true
    )
    upload_to_app_store(
      api_key: asc_api_key,
      force: true,                  # skip the HTML metadata-preview confirmation
      skip_screenshots: false,      # push fastlane/screenshots (en-US set staged for ASO)
      skip_metadata: false,         # push fastlane/metadata (release notes, keywords, subtitle, promo)
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: false,     # upload only — submit manually after review
      automatic_release: false
    )
    UI.success("Build + What's New uploaded. Review and Submit in App Store Connect.")
  end
end
