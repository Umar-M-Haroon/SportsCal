# Snapfile — automated App Store screenshots (fastlane snapshot)
#
# Run with:  bundle exec fastlane snapshot   (or: fastlane snapshot)
# Then frame + caption with:  fastlane frameit  (reuses fastlane/screenshots)
#
# NOTE: requires three one-time setup steps — see fastlane/SCREENSHOTS.md:
#   1. Add fastlane/SnapshotHelper.swift to the SportsCalUITests *target*
#      (Xcode: select the file -> File Inspector -> Target Membership ->
#       check SportsCalUITests).
#   2. Add the `testSnapshots` UITest (code in SCREENSHOTS.md).
#   3. Add a demo-seed launch path so screenshots aren't empty (SCREENSHOTS.md).

# 6.9" is the currently-required iPhone size; 6.5" is the accepted fallback;
# plus the 12.9"/13" iPad. ASC up-scales these to the smaller device classes.
devices([
  "iPhone 16 Pro Max",       # 6.9"  -> 1320x2868
  "iPhone 14 Plus",          # 6.5"  -> 1284x2778
  "iPad Pro 13-inch (M4)"    # 13"   -> iPad screenshots
])

languages([
  "en-US",
  "en-GB"                    # mirror the new en-GB localization
])

# Scheme must build the app AND run the SportsCalUITests target in its Test action.
scheme("SportsCal (iOS)")

# Only run the screenshot test, not the whole UITest suite.
only_testing(["SportsCalUITests/SportsCalUITests/testSnapshots"])

output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)

# Clean, deterministic status bar (9:41, full battery/signal).
override_status_bar(true)

# Simulators are heavy; run one at a time for stability.
concurrent_simulators(false)
stop_after_first_error(false)
