(common_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "no-referrer"
        -Server
        -Via
    }
}

api.sportscal.app {
    import common_headers

    # Compress responses (gzip for the iOS/Watch URLSession clients, zstd for
    # browsers). The /v2025/schedules JSON is highly repetitive and compresses
    # ~12x, turning a multi-MB download into a few hundred KB on the wire.
    encode zstd gzip

    @admin path /admin /admin/* /admin/assets/*
    respond @admin 404

    reverse_proxy app:8080
}

sportscal.app {
    import common_headers

    encode zstd gzip

    @admin path /admin /admin/* /admin/assets/*
    respond @admin 404

    reverse_proxy app:8080
}
