# SportsCal Production Environment Variables
# Copy this file to .env.production and fill in your values

# Apple Push Notifications
APNSkeyID=YOUR_APNS_KEY_ID
TeamID=YOUR_APPLE_TEAM_ID

# TheSportsDB API
SportsDB_API_KEY=YOUR_SPORTSDB_API_KEY

# API Authentication (SHA256 hash of your API key)
API_KEY_HASH=YOUR_API_KEY_SHA256_HASH

# Admin Dashboard Authentication — separate from the app API key so that a
# leaked app-binary key cannot reach admin endpoints. Generate with:
#   KEY=$(openssl rand -hex 32)
#   HASH=$(printf '%s' "$KEY" | shasum -a 256 | cut -d' ' -f1)
ADMIN_API_KEY_HASH=YOUR_ADMIN_KEY_SHA256_HASH

# App Attest → JWT session tokens (see SportsCalServer/docs/app-attest-plan.md)
#
# Both are optional in the sense that the server boots without them — it only
# logs a warning and clients stay on the shared API key above. Check the boot
# logs after deploying to confirm they were picked up.
#
# Signing key for the session JWTs minted after a successful attestation.
# HS256, must be at least 32 bytes or the server refuses to start.
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# How much the API demands. THE ROLLOUT DIAL — see app-attest-plan.md.
#   dual        reads + writes accept a JWT or the shared key (phase 1, default)
#   jwt-writes  writes require an attested JWT from the iOS app (phase 2)
#   jwt-strict  reads require one too (phase 3 — only once shipped clients relay
#               tokens to the widget and watch)
# Unset or unrecognized means `dual`. Do NOT advance this until the corresponding
# client version is at ~95% adoption: a route that demands a JWT will 401 every
# older install. jwt-writes/jwt-strict refuse to boot without JWT_SIGNING_KEY.
AUTH_POLICY=dual

# The App Attest relying-party identifier: <TEAM_ID>.<BUNDLE_ID>.
# Attestations whose rpIdHash doesn't match this are rejected.
APP_ATTEST_APP_ID=9GDU5ZNHX7.com.KomodoLLC.SportsCal

# DeviceCheck key ID, for App Attest fraud-risk metrics (optional — attestation
# verification does not use it). The key itself is mounted at
# DEVICECHECK_KEY_PATH by docker-compose; place AuthKey_DeviceCheck.p8 next to
# the compose file on the server. Reuses TeamID from the APNS section above.
DEVICECHECK_KEY_ID=

# Logging (trace/debug/info/notice/warning/error/critical)
LOG_LEVEL=info
