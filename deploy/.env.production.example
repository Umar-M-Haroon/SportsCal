# SportsCal Production Environment Variables
# Copy this file to .env.production and fill in your values

# Apple Push Notifications
APNSkeyID=YOUR_APNS_KEY_ID
TeamID=YOUR_APPLE_TEAM_ID

# TheSportsDB API
SportsDB_API_KEY=YOUR_SPORTSDB_API_KEY

# API Authentication (SHA256 hash of your API key)
API_KEY_HASH=YOUR_API_KEY_SHA256_HASH

# Logging (trace/debug/info/notice/warning/error/critical)
LOG_LEVEL=info
